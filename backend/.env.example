# Database configuration
POSTGRES_USER=postgres
POSTGRES_DB=film_review_db
DB_PORT=5432
REDIS_PORT=6379

# Redis configuration
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=60

# Application configuration
HOST=0.0.0.0
PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_CORS_ORIGINS=http://localhost:3000
API_VERSION=v1

# AWS Secrets Manager Configuration (Floci local development)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Secret references only (credentials are stored in AWS Secrets Manager / Floci)
DATABASE_SECRET_NAME=day4/film-review/database
JWT_SECRET_NAME=day4/film-review/jwt

# S3 Storage Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=film-review-assets
S3_ENDPOINT_URL=http://localhost:4566

# SQS Queue & DLQ Configuration
SQS_QUEUE_NAME=review-events-queue
SQS_DLQ_NAME=review-events-dlq
SQS_ENDPOINT_URL=http://localhost:4566
SQS_MAX_RECEIVE_COUNT=3
SQS_VISIBILITY_TIMEOUT=30
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_NUMBER_OF_MESSAGES=10
SIMULATE_HANDLER_FAILURE=false
